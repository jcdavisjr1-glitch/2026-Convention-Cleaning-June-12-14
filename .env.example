# Twilio credentials — get these from twilio.com after signing up
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+17275550000

# Overseer phone (digits only, no spaces or dashes)
OVERSEER_PHONE=7272787454

# Gmail email notifications (backup to SMS)
EMAIL_FROM=yourname@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
OVERSEER_EMAIL=yourname@gmail.com

# Optional: assistant overseer emails (add when available)
# ASSISTANT_EMAIL_MIMS=pierson@example.com
# ASSISTANT_EMAIL_TAYLOR=harold@example.com

# Port (Glitch/Railway set this automatically)
PORT=3000
